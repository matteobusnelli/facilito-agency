# ──────────────────────────────────────────────────────────────────────────────
# Facilito Agency — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel: set these in Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# ── Email recipients ──────────────────────────────────────────────────────────
# Comma-separated list of email addresses that receive contact form submissions.
# All addresses receive every submission simultaneously.
# Example: CONTACT_EMAILS=info@facilitoagency.it,sales@facilitoagency.it
CONTACT_EMAILS=info@facilitoagency.it

# ── Resend API key ────────────────────────────────────────────────────────────
# Get your free API key at https://resend.com (free tier: 3,000 emails/month)
# ⚠️  Never use the VITE_ prefix here — this must stay server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Sender address ────────────────────────────────────────────────────────────
# The "From" address shown in the recipient's inbox.
#
# For local testing / before domain verification:
#   RESEND_FROM_EMAIL=Facilito Agency <onboarding@resend.dev>
#
# For production (requires verifying your domain in the Resend dashboard):
#   RESEND_FROM_EMAIL=Facilito Agency <info@facilitoagency.it>
#
# How to verify your domain: https://resend.com/docs/dashboard/domains/introduction
RESEND_FROM_EMAIL=Facilito Agency <onboarding@resend.dev>

# ── Calendly ──────────────────────────────────────────────────────────────────
# Your Calendly booking link. The VITE_ prefix exposes it to the frontend bundle.
# If left empty, the "Book a call" CTA will not be shown anywhere on the site.
# Example: VITE_CALENDLY_URL=https://calendly.com/yourname/30min
VITE_CALENDLY_URL=
